{
  "expo": {
    "name": "MGM Exam",
    "slug": "mgm-exam-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mgmexam",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#faf9f5",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "in.ac.mgmcen.exam",
      "supportsTablet": true
    },
    "android": {
      "package": "in.ac.mgmcen.exam",
      "blockedPermissions": ["android.permission.READ_MEDIA_IMAGES"],
      "adaptiveIcon": {
        "backgroundColor": "#181715",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#181715",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow MGM Exam to use your photos so you can attach diagrams to questions.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#c6613f"
        }
      ],
      "expo-sharing",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ecec0cc7-7211-45d5-acce-2ccb6354b279"
      }
    },
    "owner": "codewithrushi"
  }
}
